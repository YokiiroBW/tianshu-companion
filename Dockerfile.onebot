FROM python:3.12.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN pip install --no-cache-dir nonebot2[fastapi]==2.5.0 nonebot-adapter-onebot==2.4.0 uvicorn==0.42.0 httpx==0.28.1 websockets==17.1 \
    && groupadd --gid 10001 tianshu && useradd --uid 10001 --gid 10001 --no-create-home tianshu \
    && mkdir /data && chown 10001:10001 /data
COPY integrations/nonebot/ /app/
COPY vendor/tianshu_storage-0.1.0-py3-none-any.whl /tmp/tianshu_storage-0.1.0-py3-none-any.whl
RUN pip install --no-cache-dir psycopg[binary]==3.3.6 psycopg-pool==3.3.3 redis==7.4.1 \
    && pip install --no-cache-dir --no-deps /tmp/tianshu_storage-0.1.0-py3-none-any.whl
USER 10001:10001
EXPOSE 18765
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:18765/health/live', timeout=2)"
ENTRYPOINT ["python", "-m", "tianshu_nonebot.onebot"]
CMD ["--host", "0.0.0.0", "--port", "18765", "--data-dir", "/data"]
